{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "vp:bust",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particles/paper"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": "v.amount"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_sphere": {
				"offset": [
					0,
					0,
					0
				],
				"radius": 1,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 8,
				"expiration_expression": "(v.particle_age + math.random(0,1)) > 5"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-180, 180)"
			},
			"minecraft:particle_initial_speed": "v.speed",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [
					"math.sin(v.particle_age * 90)*!q.is_on_ground",
					-10,
					"math.cos(v.particle_age * 40)*!q.is_on_ground"
				],
				"linear_drag_coefficient": 20
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					0.04,
					0.04
				],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [
						0,
						0
					],
					"uv_size": [
						16,
						16
					]
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 1,
				"collision_radius": 0.1
			},
			"minecraft:particle_appearance_tinting": {
				"color": [
					"v.color_1.r",
					"v.color_1.g",
					"v.color_1.b",
					1.0
				]
			}
		}
	}
}