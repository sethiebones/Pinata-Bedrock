{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.missile.controller": {
			"initial_state": "flying",
			"states": {
				"flying": {
					"animations": [
						"flying"
					],
					"transitions": [
						{
							"grounded": "query.is_on_ground"
						}
					]
				},
				"grounded": {
					"transitions": [
						{
							"flying": "!query.is_on_ground"
						}
					]
				}
			}
		}
	}
}