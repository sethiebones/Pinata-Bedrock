{
	"format_version": "1.20.80",
	"render_controllers": {
		"controller.render.cursor.inner": {
			"geometry": "Geometry.inner",
			"materials": [
				{
					"*": "Material.default"
				}
			],
			"textures": [
				"Texture.inner"
			],
			"overlay_color": {
				"r": 1,
				"g": 1,
				"b": 1,
				"a": "!query.property('vp:in_garden')"
			},
			"is_hurt_color": {
				"r": 1,
				"g": 1,
				"b": 1,
				"a": 0
			},
			"part_visibility": [
				{
					"*": "query.property('vp:cursor_state')=='default' || query.property('vp:cursor_state')=='inner'"
				}
			]
		},
		"controller.render.cursor.outer": {
			"geometry": "Geometry.outer",
			"materials": [
				{
					"*": "Material.default"
				}
			],
			"textures": [
				"Texture.outer"
			],
			"overlay_color": {
				"r": 0,
				"g": 0,
				"b": 0,
				"a": "!query.property('vp:in_garden')"
			},
			"is_hurt_color": {
				"r": 1,
				"g": 1,
				"b": 1,
				"a": 0
			},
			"part_visibility": [
				{
					"*": "query.property('vp:cursor_state')=='default' || query.property('vp:cursor_state')=='outer'"
				}
			]
		}
	}
}