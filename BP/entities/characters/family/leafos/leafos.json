      "vp:enable": {
        "add": {
          "component_groups": ["vp:enabled"]
        }
      },
      "vp:disable": {
        "remove": {
          "component_groups": ["vp:enabled"]
        }
      },
      "vp:cry": {
        "set_property": {
          "vp:crying": true
        },
        "trigger": {
          "event": "vp:disable"
        }
      },
      "vp:stop_cry": {
        "set_property": {
          "vp:crying": false
        },
        "trigger": {
          "event": "vp:enable"
        }
      },
      "vp:give_journal": {
        "queue_command": {
          "command": "give @p vp:journal 1"
        }
      },
      "vp:give_shovel": {
        "queue_command": {
          "command": "dialogue open @s @initiator vp:leafos_give_shovel"
        }
      },
      "vp:player_hit": {
        "add": {
          "component_groups": []
        }
      },
      "vp:set_camera": {
        "sequence": [
          {
            "add": {
              "component_groups": ["vp:camera"]
            }
          },
          {
            "queue_command": {
              "command": "scoreboard players set camera_timer ticks 1"
            }
          }
        ]
      },
      "vp:clear_camera": {
        "sequence": [
          {
            "remove": {
              "component_groups": ["vp:camera"]
            }
          },
          {
            "queue_command": {
              "command": "camera @a clear"
            }
          }
        ]
      },
      "vp:camera_queue": {
        "sequence": [
          {
            "queue_command": {
              "command": "execute unless entity @e[tag=camera] run tag @s add camera"
            }
          }
        ]
      },
