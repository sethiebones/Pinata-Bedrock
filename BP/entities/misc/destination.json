            }
          },
          {
            "deals_damage": false,
            "on_damage": {
              "event": "vp:arrive",
              "target": "damager"
            }
          }
        ]
      },
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": false
      },
      "minecraft:collision_box": {
        "width": 0.0001,
        "height": 0.0001
      },
      "minecraft:despawn": {
        "despawn_from_distance": {
          "min_distance": 32,
          "max_distance": 128
        },
        "despawn_from_inactivity": true,
        "min_range_inactivity_timer": 30
      }
    },
    "events": {
      "vp:delete": {
        "add": {
          "component_groups": ["vp:delete"]
        }
      }
    }
