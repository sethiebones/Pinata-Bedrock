{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "identifier": "vp:destination",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "vp:delete": {
        "minecraft:instant_despawn": {}
      }
    },
    "components": {
