{
    "format_version": "1.21.30",
    "minecraft:npc_dialogue": {
        "scenes": [
            {
                "scene_tag": "vp:leafos_intro",
                "npc_name": "Leafos",
                "text": {
                    "rawtext": [
                        {
                            "translate": "accessibility.leafos_intro"
                        }
                    ]
                },
                "on_open_commands": [
                    "execute as @initiator unless entity @e[tag=true_leafos, r=32] run tp @e[tag=true_leafos, r=1] @s"
                ],
                "on_close_commands": [
                    "event entity @s vp:stop_cry",
                    "event entity @s vp:disable",
                    "dialogue open @s @initiator vp:leafos_give_journal",
                    "replaceitem entity @s slot.weapon.mainhand 0 vp:journal",
                    "tag @s add has_journal"
                ]
            },
            {
                "scene_tag": "vp:leafos_give_journal",
                "npc_name": "Leafos",
                "text": {
                    "rawtext": [
                        {
                            "translate": "accessibility.leafos_give_journal"
                        }
                    ]
                },
                "on_close_commands": [
                    "replaceitem entity @s slot.weapon.mainhand 0 air",
                    "give @initiator vp:journal",
                    "dialogue open @s @initiator vp:leafos_garden_intro",
                    "tag @s remove has_journal"
                ]
            },
            {
                "scene_tag": "vp:leafos_garden_intro",
                "npc_name": "Leafos",
                "text": {
                    "rawtext": [
                        {
                            "translate": "accessibility.leafos_garden_intro"
                        }
                    ]
                },
                "on_close_commands": [
                    "tag @initiator add awaiting_garden_claiming"
                ]
            },
            {
                "scene_tag": "vp:leafos_shovel_intro",
                "npc_name": "Leafos",
                "text": {
                    "rawtext": [
                        {
                            "translate": "accessibility.leafos_shovel_intro"
                        }
                    ]
                },
                "on_close_commands": [
                    "tag @initiator remove awaiting_garden_claiming",
                    "replaceitem entity @s slot.weapon.mainhand 0 vp:freebie_shovel",
                    "tag @s add has_shovel",
                    //"tag @initiator add needs_shovel",
                    //"event entity @s vp:give_shovel"
                    "dialogue change @s vp:leafos_give_shovel @initiator"
                ]
            },
            {
                "scene_tag": "vp:leafos_give_shovel",
                "npc_name": "Leafos",
                "text": {
                    "rawtext": [
                        {
                            "translate": "accessibility.leafos_give_shovel"
                        }
                    ]
                },
                "on_close_commands": [
                    "replaceitem entity @s slot.weapon.mainhand 0 air",
                    "give @initiator vp:freebie_shovel",
                    "tag @s remove has_shovel",
                    "event entity @s vp:enable"
                ]
            },
